#: includes/famefe-notices.php:61
msgid "The data could not be saved. Please try again."
msgstr "Dataene kunne ikke gemmes. Prøv igen."

#: includes/famefe-notices.php:60
msgid "The payment has not been confirmed yet. If you paid, it will appear shortly."
msgstr "Betalingen er endnu ikke bekræftet. Hvis du har betalt, vises den snart."

#: includes/famefe-notices.php:59
msgid "The payment service could not be reached. Please try again later."
msgstr "Betalingstjenesten kunne ikke nås. Prøv igen senere."

#: includes/famefe-notices.php:58
msgid "Online payment is not set up."
msgstr "Onlinebetaling er ikke sat op."

#: includes/famefe-notices.php:57
msgid "The block of this form was not found on the page. Please reload the page."
msgstr "Blokken til denne formular blev ikke fundet på siden. Genindlæs siden."

#: includes/famefe-notices.php:56
msgid "There is nothing to pay."
msgstr "Der er intet at betale."

#: includes/famefe-notices.php:55
msgid "The membership fee for this period has already been paid."
msgstr "Kontingentet for denne periode er allerede betalt."

#: includes/famefe-notices.php:54
msgid "Choose a valid payment method."
msgstr "Vælg en gyldig betalingsmetode."

#: includes/famefe-notices.php:53
msgid "Enter a valid amount."
msgstr "Indtast et gyldigt beløb."

#: includes/famefe-notices.php:51
msgid "Describe the work, please."
msgstr "Beskriv venligst arbejdet."

#: includes/famefe-notices.php:50
msgid "Hours cannot be recorded for this date any more."
msgstr "Der kan ikke længere registreres timer for denne dato."

#: includes/famefe-notices.php:49
msgid "These hours can no longer be deleted here; the time limit has passed."
msgstr "Disse timer kan ikke længere slettes her; fristen er udløbet."

#: includes/famefe-notices.php:48
msgid "Enter a valid number of hours."
msgstr "Indtast et gyldigt antal timer."

#: includes/famefe-notices.php:47
msgid "The member has hours or payments and cannot be deleted. End the membership instead."
msgstr "Medlemmet har timer eller betalinger og kan ikke slettes. Afslut i stedet medlemskabet."

#: includes/famefe-notices.php:45
msgid "This e-mail address is already used by another user account."
msgstr "Denne e-mailadresse bruges allerede af en anden brugerkonto."

#: includes/famefe-notices.php:44
msgid "Enter a valid e-mail address."
msgstr "Indtast en gyldig e-mailadresse."

#: includes/famefe-notices.php:43
msgid "This change is not possible for the member (check the status and the date)."
msgstr "Denne ændring er ikke mulig for medlemmet (kontroller status og dato)."

#: includes/famefe-notices.php:42
msgid "\"Member since\" cannot be after the end of the membership."
msgstr "\"Medlem siden\" kan ikke ligge efter medlemskabets ophør."

#: includes/famefe-notices.php:41
msgid "Choose a valid membership type."
msgstr "Vælg en gyldig medlemstype."

#: includes/famefe-notices.php:40
msgid "Enter a valid date."
msgstr "Indtast en gyldig dato."

#: includes/famefe-notices.php:39
msgid "Enter the first or the last name."
msgstr "Indtast fornavn eller efternavn."

#: includes/famefe-notices.php:38
msgid "The record was not found."
msgstr "Posten blev ikke fundet."

#: includes/famefe-notices.php:37
msgid "The form has expired. Please reload the page and try again."
msgstr "Formularen er udløbet. Genindlæs siden, og prøv igen."

#: includes/famefe-notices.php:36
msgid "Please log in first."
msgstr "Log først ind."

#: includes/famefe-notices.php:35
msgid "You are not allowed to do this."
msgstr "Du har ikke tilladelse til at gøre dette."

#: includes/famefe-notices.php:33
msgid "The settings were saved."
msgstr "Indstillingerne blev gemt."

#: includes/famefe-notices.php:32
msgid "The payment was cancelled. You can try again at any time."
msgstr "Betalingen blev annulleret. Du kan prøve igen når som helst."

#: includes/famefe-notices.php:31
msgid "Thank you, your membership fee was paid."
msgstr "Tak, dit kontingent er betalt."

#: includes/famefe-notices.php:30
msgid "The payment was deleted."
msgstr "Betalingen blev slettet."

#: includes/famefe-notices.php:29
msgid "The payment was recorded."
msgstr "Betalingen blev registreret."

#: includes/famefe-notices.php:28
msgid "The hours were deleted."
msgstr "Timerne blev slettet."

#: includes/famefe-notices.php:27
msgid "The hours were saved."
msgstr "Timerne blev gemt."

#: includes/famefe-notices.php:26
msgid "Thank you, your hours were recorded."
msgstr "Tak, dine timer er registreret."

#: includes/famefe-notices.php:25
msgid "The member was deleted."
msgstr "Medlemmet blev slettet."

#: includes/famefe-notices.php:24
msgid "The change of the membership was recorded."
msgstr "Ændringen af medlemskabet blev registreret."

#: includes/famefe-notices.php:23
msgid "The member was saved."
msgstr "Medlemmet blev gemt."

#: includes/famefe-notices.php:22
msgid "The member and the user account were created. The member got an e-mail with a link for setting the password."
msgstr "Medlemmet og brugerkontoen blev oprettet. Medlemmet har fået en e-mail med et link til at vælge adgangskode."

#: includes/famefe-notices.php:21
msgid "The member and the user account were created."
msgstr "Medlemmet og brugerkontoen blev oprettet."

#: includes/famefe-notices.php:20
