#: build/blocks/fee-explanation/render.php:132
#: build/blocks/membership-fees/render.php:42
msgid "Calculated fee"
msgstr "Vypočtený příspěvek"

#: build/blocks/fee-explanation/render.php:134
#: build/blocks/membership-fees/render.php:43
#: build/blocks/fee-explanation/index.js:2
#: build/blocks/membership-fees/index.js:2
msgid "Discount"
msgstr "Sleva"

#: build/blocks/fee-explanation/render.php:135
#: build/blocks/membership-fees/render.php:45
msgid "Fee to pay"
msgstr "K úhradě"

#: build/blocks/fee-explanation/render.php:176
msgid "4. Discount"
msgstr "4. Sleva"

#. translators: 1: share of members in percent, 2: discount in percent, 3: number of members with the discount.
#: build/blocks/fee-explanation/render.php:181
msgid "The %1$s %% of regular members with the lowest calculated fees pay %2$s %% less (here %3$d members; members with the same fee as the last of them get it too). The discount is not added to the fees of the others, so the club collects less than the expected total."
msgstr "%1$s %% řádných členů s nejnižšími vypočtenými příspěvky platí o %2$s %% méně (zde %3$d členů; slevu dostanou i ti se stejným příspěvkem jako poslední z nich). Sleva se nepřičítá ostatním, klub tedy vybere méně než očekávaný součet."

#: build/blocks/fee-explanation/render.php:190
msgid "Whoever does not volunteer pays more than the base fee: paying instead of working should never be the cheaper choice."
msgstr "Kdo nepracuje, platí víc než základní příspěvek: zaplatit místo práce nesmí být nikdy výhodnější."

