msgstr "Vypnuto: hodiny se vždy zapíší na dnešek, takže nikdo nemůže dopisovat hodiny do minulosti ani měnit uzavřené období. Administrátoři a editoři mohou datum zvolit vždy."

#: build/blocks/hours-form/index.js:1
msgid "Days back"
msgstr "Dní zpětně"

#: build/blocks/hours-form/index.js:1
msgid "How old the date of the work may be. 0 = only today."
msgstr "Jak staré smí být datum práce. 0 = jen dnes."

#: build/blocks/hours-form/index.js:1
msgid "Button text"
msgstr "Text tlačítka"

#: build/blocks/hours-form/index.js:1
msgid "Description of the work is required"
msgstr "Popis práce je povinný"

#: build/blocks/hours-form/index.js:1
msgid "Show my recent entries"
msgstr "Zobrazit moje poslední zápisy"

#: build/blocks/hours-form/index.js:1
msgid "Number of recent entries"
msgstr "Počet posledních zápisů"

#: build/blocks/hours-list/index.js:1
