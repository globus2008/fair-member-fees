msgid "As in the plugin settings"
msgstr "Podle nastavení pluginu"

#: build/blocks/hours-list/index.js:1
msgid "Leave empty for no limit."
msgstr "Prázdné = bez omezení."

#: build/blocks/hours-list/index.js:1
msgid "Maximum entries"
msgstr "Nejvýše zápisů"

#: build/blocks/hours-list/index.js:1
msgid "Only the hours of the logged-in visitor"
msgstr "Jen hodiny přihlášeného návštěvníka"

#: build/blocks/hours-list/index.js:1
#: build/blocks/membership-fees/index.js:2
msgid "Display"
msgstr "Zobrazení"

#: build/blocks/hours-list/index.js:1
msgid "Total below"
msgstr "Součet pod tabulkou"

#: build/blocks/hours-list/index.js:1
msgid "Deleting"
msgstr "Mazání"

#: build/blocks/hours-list/index.js:1
msgid "Allow deleting hours"
msgstr "Povolit mazání hodin"

#: build/blocks/hours-list/index.js:1
msgid "Members: days after recording"
msgstr "Členové: dní od zápisu"

#: build/blocks/hours-list/index.js:1
msgid "Members delete only hours they recorded themselves, e.g. after a mistake. 0 = only on the day of recording."
msgstr "Členové mažou jen hodiny, které sami zapsali, třeba po omylu. 0 = jen v den zápisu."

#: build/blocks/hours-list/index.js:1
msgid "Administrators and editors: days after recording"
msgstr "Administrátoři a editoři: dní od zápisu"

#: build/blocks/hours-list/index.js:1
msgid "They may delete any entry within this time. Older entries can still be deleted in Member Fees → Volunteer hours."
msgstr "V této lhůtě mohou smazat jakýkoli záznam. Starší záznamy lze dál smazat v Členské příspěvky → Brigádnické hodiny."

#: build/blocks/members-list/index.js:1
msgid "Regular members"
msgstr "Řádní členové"

#: build/blocks/members-list/index.js:1
msgid "Honorary members"
msgstr "Čestní členové"

#: build/blocks/members-list/index.js:1
msgid "Only for logged-in visitors"
msgstr "Jen pro přihlášené návštěvníky"

#: build/blocks/members-list/index.js:1
#: build/blocks/membership-fees/index.js:2
msgid "Columns"
msgstr "Sloupce"

#: build/blocks/membership-fees/index.js:1
msgid "Period and fee"
msgstr "Období a příspěvek"

#: build/blocks/membership-fees/index.js:1
msgid "Members of this period pay; their hours of this period lower the fee. Payments are recorded for exactly this period."
msgstr "Platí členové tohoto období; jejich hodiny z tohoto období příspěvek snižují. Platby se zapisují přesně pro toto období."

#: build/blocks/membership-fees/index.js:2
msgid "The fee of a regular member when nobody volunteers. All regular members together pay the base fee times their number."
msgstr "Příspěvek řádného člena, když nikdo nepracuje. Všichni řádní členové dohromady zaplatí základní příspěvek krát jejich počet."

#: build/blocks/membership-fees/index.js:2
msgid "Discount for the lowest fees"
msgstr "Sleva pro nejnižší příspěvky"

#: build/blocks/membership-fees/index.js:2
msgid "Members who volunteered the most pay even less. The discount is not added to the fees of the others."
msgstr "Kdo odpracoval nejvíc, zaplatí ještě méně. Sleva se nepřičítá k příspěvkům ostatních."

#: build/blocks/membership-fees/index.js:2
msgid "Calculated fee and discount (when the discount is on)"
msgstr "Vypočtený příspěvek a sleva (je-li sleva zapnutá)"

#: build/blocks/membership-fees/index.js:2
msgid "List honorary members"
msgstr "Zobrazit čestné členy"

#: build/blocks/membership-fees/index.js:2
msgid "Period and base fee above the table"
msgstr "Období a základní příspěvek nad tabulkou"

#: build/blocks/membership-fees/index.js:2
msgid "Totals rows at the end of the table"
msgstr "Součtové řádky na konci tabulky"

#: build/blocks/membership-fees/index.js:2
msgid "Highlight the logged-in member"
msgstr "Zvýraznit přihlášeného člena"

#: build/blocks/membership-fees/index.js:2
msgid "Online payment button"
msgstr "Tlačítko platby online"

