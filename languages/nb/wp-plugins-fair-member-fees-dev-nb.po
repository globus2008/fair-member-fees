#: build/blocks/hours-list/index.js:1 src/blocks/hours-list/index.js:127
msgid "They may delete any entry within this time. Older entries can still be deleted in Member Fees → Volunteer hours."
msgstr "De kan slette hvilken som helst registrering innenfor denne tiden. Eldre registreringer kan fortsatt slettes under Kontingenter → Dugnadstimer."

#: build/blocks/hours-list/index.js:1 src/blocks/hours-list/index.js:123
msgid "Administrators and editors: days after recording"
msgstr "Administratorer og redaktører: dager etter registrering"

#: build/blocks/hours-list/index.js:1 src/blocks/hours-list/index.js:106
msgid "Members delete only hours they recorded themselves, e.g. after a mistake. 0 = only on the day of recording."
msgstr "Medlemmer sletter bare timer de selv har registrert, f.eks. etter en feil. 0 = bare på registreringsdagen."

#: build/blocks/hours-list/index.js:1 src/blocks/hours-list/index.js:102
msgid "Members: days after recording"
msgstr "Medlemmer: dager etter registrering"

