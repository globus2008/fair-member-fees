#: build/blocks/membership-fees/index.js:3 src/blocks/membership-fees/index.js:155
msgid "Highlight the logged-in member"
msgstr "Wyróżnij zalogowanego członka"

#: build/blocks/membership-fees/index.js:3 src/blocks/membership-fees/index.js:147
msgid "Period and base fee above the table"
msgstr "Okres i składka podstawowa nad tabelą"

#: build/blocks/membership-fees/index.js:3 src/blocks/membership-fees/index.js:143
msgid "List honorary members"
msgstr "Pokaż członków honorowych"

#: build/blocks/membership-fees/index.js:3 src/blocks/membership-fees/index.js:121
msgid "Calculated fee and discount (when the discount is on)"
msgstr "Obliczona składka i zniżka (gdy zniżka jest włączona)"

#: build/blocks/membership-fees/index.js:3 src/blocks/membership-fees/index.js:94
msgid "Members who volunteered the most pay even less. The discount is not added to the fees of the others."
msgstr "Członkowie, którzy przepracowali najwięcej, płacą jeszcze mniej. Zniżka nie jest doliczana do składek pozostałych."

#: build/blocks/membership-fees/index.js:3 src/blocks/membership-fees/index.js:90
msgid "Discount for the lowest fees"
msgstr "Zniżka dla najniższych składek"

#: build/blocks/membership-fees/index.js:3 src/blocks/membership-fees/index.js:72
msgid "Turn on once the volunteer hours of the period are closed: members then see their final fee and can pay it. While it is off, the fees are shown as calculated from the hours recorded so far. Leave it off if you do not collect fees through this page."
msgstr "Włącz, gdy godziny wolontariatu okresu zostaną zamknięte: członkowie zobaczą wtedy swoją ostateczną składkę i będą mogli ją zapłacić. Dopóki jest wyłączony, składki są pokazywane jako obliczone z godzin zarejestrowanych do tej pory. Pozostaw wyłączony, jeśli nie pobierasz składek przez tę stronę."

#: build/blocks/membership-fees/index.js:3 src/blocks/membership-fees/index.js:68
msgid "Payment button (the fees are final)"
msgstr "Przycisk płatności (składki są ostateczne)"

#: build/blocks/membership-fees/index.js:3 src/blocks/membership-fees/index.js:59
msgid "The fee of a regular member when nobody volunteers. All regular members together pay the base fee times their number."
msgstr "Składka członka zwyczajnego, gdy nikt nie przepracuje godzin wolontariatu. Wszyscy członkowie zwyczajni razem płacą składkę podstawową pomnożoną przez ich liczbę."

#: build/blocks/membership-fees/index.js:2 src/blocks/membership-fees/index.js:46
msgid "Members of this period pay; their hours of this period lower the fee. Payments are recorded for exactly this period."
msgstr "Płacą członkowie tego okresu; ich godziny w tym okresie obniżają składkę. Płatności są rejestrowane dokładnie dla tego okresu."

#: build/blocks/membership-fees/index.js:2 src/blocks/membership-fees/index.js:42
msgid "Period and fee"
msgstr "Okres i składka"

#: build/blocks/members-list/index.js:1 build/blocks/membership-fees/index.js:3 src/blocks/members-list/index.js:54 src/blocks/membership-fees/index.js:101
msgid "Columns"
msgstr "Kolumny"

#: build/blocks/members-list/index.js:1 src/blocks/members-list/index.js:46
msgid "Only for logged-in visitors"
msgstr "Tylko dla zalogowanych odwiedzających"

#: build/blocks/members-list/index.js:1 build/blocks/membership-fees/index.js:3 src/blocks/members-list/index.js:42 src/blocks/membership-fees/index.js:151
msgid "Totals rows at the end of the table"
msgstr "Wiersze sum na końcu tabeli"

#: build/blocks/members-list/index.js:1 src/blocks/members-list/index.js:30
msgid "Honorary members"
msgstr "Członkowie honorowi"

#: build/blocks/members-list/index.js:1 src/blocks/members-list/index.js:26
msgid "Regular members"
msgstr "Członkowie zwyczajni"

#: build/blocks/members-list/index.js:1 build/blocks/membership-fees/index.js:2 src/blocks/shared.js:360
msgid "Totals rows text"
msgstr "Tekst wierszy sum"

#: build/blocks/members-list/index.js:1 build/blocks/membership-fees/index.js:2 src/blocks/shared.js:356
msgid "Totals rows background"
msgstr "Tło wierszy sum"

#: build/blocks/members-list/index.js:1 build/blocks/membership-fees/index.js:2 src/blocks/shared.js:353
msgid "Header text"
msgstr "Tekst nagłówka"

#: build/blocks/members-list/index.js:1 build/blocks/membership-fees/index.js:2 src/blocks/shared.js:351
msgid "Header background"
msgstr "Tło nagłówka"

#: build/blocks/members-list/index.js:1 build/blocks/membership-fees/index.js:2 src/blocks/shared.js:346
msgid "Table colours"
msgstr "Kolory tabeli"

#: build/blocks/hours-list/index.js:1 src/blocks/hours-list/index.js:127
msgid "They may delete any entry within this time. Older entries can still be deleted in Member Fees → Volunteer hours."
msgstr "W tym czasie mogą usunąć dowolny wpis. Starsze wpisy nadal można usunąć w Składki członkowskie → Godziny wolontariatu."

#: build/blocks/hours-list/index.js:1 src/blocks/hours-list/index.js:123
msgid "Administrators and editors: days after recording"
msgstr "Administratorzy i redaktorzy: dni po zarejestrowaniu"

#: build/blocks/hours-list/index.js:1 src/blocks/hours-list/index.js:106
msgid "Members delete only hours they recorded themselves, e.g. after a mistake. 0 = only on the day of recording."
msgstr "Członkowie usuwają tylko godziny, które sami zarejestrowali, np. po pomyłce. 0 = tylko w dniu zarejestrowania."

#: build/blocks/hours-list/index.js:1 src/blocks/hours-list/index.js:102
msgid "Members: days after recording"
msgstr "Członkowie: dni po zarejestrowaniu"

#: build/blocks/hours-list/index.js:1 src/blocks/hours-list/index.js:91
msgid "Allow deleting hours"
msgstr "Zezwól na usuwanie godzin"

#: build/blocks/hours-list/index.js:1 src/blocks/hours-list/index.js:84
msgid "Deleting"
msgstr "Usuwanie"

#: build/blocks/hours-list/index.js:1 src/blocks/hours-list/index.js:79
msgid "Total below"
msgstr "Suma poniżej"

#: build/blocks/hours-list/index.js:1 build/blocks/membership-fees/index.js:3 src/blocks/hours-list/index.js:60 src/blocks/membership-fees/index.js:130
msgid "Display"
msgstr "Wyświetlanie"

#: build/blocks/hours-list/index.js:1 src/blocks/hours-list/index.js:52
msgid "Only the hours of the logged-in visitor"
msgstr "Tylko godziny zalogowanego odwiedzającego"

#: build/blocks/hours-list/index.js:1 src/blocks/hours-list/index.js:37
msgid "Maximum entries"
msgstr "Maksymalna liczba wpisów"

#: build/blocks/hours-list/index.js:1 src/blocks/hours-list/index.js:29
msgid "Leave empty for no limit."
msgstr "Pozostaw puste, aby nie było limitu."

#: build/blocks/hours-list/index.js:1 build/blocks/members-list/index.js:1 build/blocks/membership-fees/index.js:1 src/blocks/shared.js:94
msgid "As in the plugin settings"
msgstr "Jak w ustawieniach wtyczki"

#: build/blocks/hours-list/index.js:1 build/blocks/members-list/index.js:1 build/blocks/membership-fees/index.js:1 src/blocks/shared.js:89
msgid "Names"
msgstr "Imiona i nazwiska"

#: build/blocks/hours-form/index.js:1 src/blocks/hours-form/index.js:106
msgid "Number of recent entries"
msgstr "Liczba ostatnich wpisów"

#: build/blocks/hours-form/index.js:1 src/blocks/hours-form/index.js:96
msgid "Show my recent entries"
msgstr "Pokaż moje ostatnie wpisy"

#: build/blocks/hours-form/index.js:1 src/blocks/hours-form/index.js:92
msgid "Description of the work is required"
msgstr "Opis pracy jest wymagany"

#: build/blocks/hours-form/index.js:1 src/blocks/hours-form/index.js:81
msgid "Button text"
msgstr "Tekst przycisku"

#: build/blocks/hours-form/index.js:1 src/blocks/hours-form/index.js:63
msgid "How old the date of the work may be. 0 = only today."
msgstr "Jak dawna może być data pracy. 0 = tylko dzisiaj."

#: build/blocks/hours-form/index.js:1 src/blocks/hours-form/index.js:62
msgid "Days back"
msgstr "Dni wstecz"

#: build/blocks/hours-form/index.js:1 src/blocks/hours-form/index.js:49
msgid "Off: hours are always recorded for today, so nobody can add hours to the past or change a closed period. Administrators and editors can always choose the date."
msgstr "Wyłączone: godziny są zawsze rejestrowane na dzisiaj, więc nikt nie może dodać godzin w przeszłości ani zmienić zamkniętego okresu. Administratorzy i redaktorzy zawsze mogą wybrać datę."

#: build/blocks/hours-form/index.js:1 src/blocks/hours-form/index.js:45
msgid "Members may change the date"
msgstr "Członkowie mogą zmienić datę"

#: build/blocks/hours-form/index.js:1 src/blocks/hours-form/index.js:35
msgid "Step of the hours"
msgstr "Krok godzin"

#: build/blocks/hours-form/index.js:1 src/blocks/hours-form/index.js:23
msgid "Maximum hours per entry"
msgstr "Maksymalna liczba godzin na wpis"

#: build/blocks/hours-form/index.js:1 src/blocks/hours-form/index.js:18
msgid "Form"
msgstr "Formularz"

#: build/blocks/fee-explanation/index.js:3 src/blocks/fee-explanation/index.js:71
msgid "Explain the discount"
msgstr "Wyjaśnij zniżkę"

#: build/blocks/fee-explanation/index.js:3 src/blocks/fee-explanation/index.js:53
msgid "Hours of the honorary members"
msgstr "Godziny członków honorowych"

#: build/blocks/fee-explanation/index.js:3 src/blocks/fee-explanation/index.js:41
msgid "One number per member, separated by commas or spaces."
msgstr "Jedna liczba na członka, oddzielone przecinkami lub spacjami."

#: build/blocks/fee-explanation/index.js:3 src/blocks/fee-explanation/index.js:37
msgid "Hours of the regular members"
msgstr "Godziny członków zwyczajnych"

