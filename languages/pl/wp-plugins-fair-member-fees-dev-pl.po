msgid "Total to collect"
msgstr "Suma do zebrania"

#: build/blocks/fee-explanation/index.js:1 build/blocks/membership-fees/index.js:1 src/blocks/shared.js:259
msgid "Percentage"
msgstr "Procent"

#: build/blocks/fee-explanation/index.js:1 build/blocks/membership-fees/index.js:1 src/blocks/shared.js:254
msgid "Discount given by"
msgstr "Zniżka określona przez"

#: build/blocks/fee-explanation/index.js:1 build/blocks/membership-fees/index.js:1 src/blocks/shared.js:244
