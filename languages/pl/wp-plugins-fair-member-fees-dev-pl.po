msgstr "Udział członków z najniższymi składkami (%)"

#. translators: %s: list of member names.
#: includes/famefe-users.php:190
msgid "These accounts belong to members: %s. The members, their history, hours and payments stay in the register; only the link to the account is removed. To end a membership, use Member Fees → Members."
msgstr "Te konta należą do członków: %s. Członkowie, ich historia, godziny i płatności pozostają w rejestrze; usuwane jest tylko powiązanie z kontem. Aby zakończyć członkostwo, użyj Składki członkowskie → Członkowie."

#: includes/famefe-users.php:93
msgid "The first name, last name and e-mail of this profile are also the details of the member."
msgstr "Imię, nazwisko i e-mail tego profilu są też danymi członka."

#: includes/famefe-users.php:91
msgid "Membership and history"
msgstr "Członkostwo i historia"

#: includes/famefe-users.php:87
msgid "Add as member"
msgstr "Dodaj jako członka"

#: includes/famefe-users.php:86
msgid "Not a member."
msgstr "Nie jest członkiem."

#. translators: 1: first day of the period, 2: last day of the period.
#: includes/famefe-stripe.php:122
msgid "Membership fee %1$s – %2$s"
msgstr "Składka członkowska %1$s – %2$s"

#. translators: 1: amount, 2: currency symbol or code (Kč, €, USD).
#: includes/famefe-settings.php:95
msgid "%1$s %2$s"
msgstr "%1$s %2$s"

#: includes/famefe-notices.php:61
msgid "The data could not be saved. Please try again."
msgstr "Nie udało się zapisać danych. Spróbuj ponownie."

#: includes/famefe-notices.php:60
msgid "The payment has not been confirmed yet. If you paid, it will appear shortly."
msgstr "Płatność nie została jeszcze potwierdzona. Jeśli zapłacono, pojawi się wkrótce."

#: includes/famefe-notices.php:59
msgid "The payment service could not be reached. Please try again later."
msgstr "Nie udało się połączyć z usługą płatności. Spróbuj ponownie później."

#: includes/famefe-notices.php:58
msgid "Online payment is not set up."
msgstr "Płatność online nie jest skonfigurowana."

#: includes/famefe-notices.php:57
msgid "The block of this form was not found on the page. Please reload the page."
msgstr "Nie znaleziono bloku tego formularza na stronie. Odśwież stronę."

#: includes/famefe-notices.php:56
msgid "There is nothing to pay."
msgstr "Nie ma nic do zapłaty."

#: includes/famefe-notices.php:55
msgid "The membership fee for this period has already been paid."
msgstr "Składka członkowska za ten okres została już zapłacona."

#: includes/famefe-notices.php:54
msgid "Choose a valid payment method."
msgstr "Wybierz prawidłową metodę płatności."

#: includes/famefe-notices.php:53
msgid "Enter a valid amount."
msgstr "Wpisz prawidłową kwotę."

#: includes/famefe-notices.php:51
msgid "Describe the work, please."
msgstr "Opisz, proszę, wykonaną pracę."

#: includes/famefe-notices.php:50
msgid "Hours cannot be recorded for this date any more."
msgstr "Dla tej daty nie można już rejestrować godzin."

#: includes/famefe-notices.php:49
msgid "These hours can no longer be deleted here; the time limit has passed."
msgstr "Tych godzin nie można już tu usunąć; termin minął."

#: includes/famefe-notices.php:48
msgid "Enter a valid number of hours."
msgstr "Wpisz prawidłową liczbę godzin."

#: includes/famefe-notices.php:47
msgid "The member has hours or payments and cannot be deleted. End the membership instead."
msgstr "Członek ma godziny lub płatności i nie może zostać usunięty. Zamiast tego zakończ członkostwo."

#: includes/famefe-notices.php:45
msgid "This e-mail address is already used by another user account."
msgstr "Ten adres e-mail jest już używany przez inne konto użytkownika."

#: includes/famefe-notices.php:44
msgid "Enter a valid e-mail address."
msgstr "Wpisz prawidłowy adres e-mail."

#: includes/famefe-notices.php:43
msgid "This change is not possible for the member (check the status and the date)."
msgstr "Ta zmiana nie jest możliwa dla tego członka (sprawdź status i datę)."

#: includes/famefe-notices.php:42
msgid "\"Member since\" cannot be after the end of the membership."
msgstr "„Członek od” nie może być późniejsze niż koniec członkostwa."

#: includes/famefe-notices.php:41
msgid "Choose a valid membership type."
msgstr "Wybierz prawidłowy rodzaj członkostwa."

#: includes/famefe-notices.php:40
msgid "Enter a valid date."
msgstr "Wpisz prawidłową datę."

#: includes/famefe-notices.php:39
msgid "Enter the first or the last name."
msgstr "Wpisz imię lub nazwisko."

#: includes/famefe-notices.php:38
msgid "The record was not found."
msgstr "Nie znaleziono wpisu."

#: includes/famefe-notices.php:37
msgid "The form has expired. Please reload the page and try again."
msgstr "Formularz wygasł. Odśwież stronę i spróbuj ponownie."

#: includes/famefe-notices.php:36
msgid "Please log in first."
msgstr "Najpierw się zaloguj."

#: includes/famefe-notices.php:35
msgid "You are not allowed to do this."
msgstr "Nie masz uprawnień do wykonania tej czynności."

#: includes/famefe-notices.php:33
msgid "The settings were saved."
msgstr "Ustawienia zostały zapisane."

#: includes/famefe-notices.php:32
msgid "The payment was cancelled. You can try again at any time."
msgstr "Płatność została anulowana. Możesz spróbować ponownie w dowolnym momencie."

