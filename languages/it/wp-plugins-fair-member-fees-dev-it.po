msgstr "Il socio ha ore o pagamenti e non può essere eliminato. Termina invece l'iscrizione."

#: includes/famefe-notices.php:45
msgid "This e-mail address is already used by another user account."
msgstr "Questo indirizzo email è già usato da un altro account utente."

#: includes/famefe-notices.php:44
msgid "Enter a valid e-mail address."
msgstr "Inserisci un indirizzo email valido."

#: includes/famefe-notices.php:43
