#. translators: %s: list of member names.
#: includes/famefe-users.php:190
msgid "These accounts belong to members: %s. The members, their history, hours and payments stay in the register; only the link to the account is removed. To end a membership, use Member Fees → Members."
msgstr "Các tài khoản này thuộc về hội viên: %s. Các hội viên cùng lịch sử, giờ và khoản thanh toán của họ vẫn được giữ trong sổ đăng ký; chỉ liên kết với tài khoản bị gỡ bỏ. Để chấm dứt tư cách hội viên, hãy dùng Phí hội viên → Hội viên."

#: includes/famefe-users.php:93
msgid "The first name, last name and e-mail of this profile are also the details of the member."
msgstr "Tên, họ và email của hồ sơ này cũng là thông tin của hội viên."

#: includes/famefe-users.php:91
msgid "Membership and history"
msgstr "Tư cách hội viên và lịch sử"

#: includes/famefe-users.php:87
msgid "Add as member"
msgstr "Thêm làm hội viên"

#: includes/famefe-users.php:86
msgid "Not a member."
msgstr "Không phải hội viên."

#. translators: 1: first day of the period, 2: last day of the period.
#: includes/famefe-stripe.php:122
msgid "Membership fee %1$s – %2$s"
msgstr "Phí hội viên %1$s – %2$s"

#. translators: 1: amount, 2: currency symbol or code (Kč, €, USD).
#: includes/famefe-settings.php:95
msgid "%1$s %2$s"
msgstr "%1$s %2$s"

#: includes/famefe-notices.php:61
msgid "The data could not be saved. Please try again."
msgstr "Không thể lưu dữ liệu. Vui lòng thử lại."

#: includes/famefe-notices.php:60
msgid "The payment has not been confirmed yet. If you paid, it will appear shortly."
msgstr "Khoản thanh toán chưa được xác nhận. Nếu bạn đã thanh toán, nó sẽ sớm xuất hiện."

#: includes/famefe-notices.php:59
msgid "The payment service could not be reached. Please try again later."
msgstr "Không thể kết nối với dịch vụ thanh toán. Vui lòng thử lại sau."

#: includes/famefe-notices.php:58
msgid "Online payment is not set up."
msgstr "Thanh toán trực tuyến chưa được thiết lập."

#: includes/famefe-notices.php:57
msgid "The block of this form was not found on the page. Please reload the page."
msgstr "Không tìm thấy khối của biểu mẫu này trên trang. Vui lòng tải lại trang."

#: includes/famefe-notices.php:56
msgid "There is nothing to pay."
msgstr "Không có gì cần thanh toán."

#: includes/famefe-notices.php:55
msgid "The membership fee for this period has already been paid."
msgstr "Phí hội viên của kỳ này đã được thanh toán."

#: includes/famefe-notices.php:54
msgid "Choose a valid payment method."
msgstr "Hãy chọn một phương thức thanh toán hợp lệ."

#: includes/famefe-notices.php:53
msgid "Enter a valid amount."
msgstr "Hãy nhập số tiền hợp lệ."

#: includes/famefe-notices.php:51
msgid "Describe the work, please."
msgstr "Vui lòng mô tả công việc."

#: includes/famefe-notices.php:50
msgid "Hours cannot be recorded for this date any more."
msgstr "Không thể ghi nhận giờ cho ngày này nữa."

#: includes/famefe-notices.php:49
msgid "These hours can no longer be deleted here; the time limit has passed."
msgstr "Không thể xóa những giờ này ở đây nữa; đã quá thời hạn."

#: includes/famefe-notices.php:48
msgid "Enter a valid number of hours."
msgstr "Hãy nhập số giờ hợp lệ."

#: includes/famefe-notices.php:47
msgid "The member has hours or payments and cannot be deleted. End the membership instead."
msgstr "Hội viên có giờ hoặc khoản thanh toán nên không thể xóa. Thay vào đó, hãy chấm dứt tư cách hội viên."

