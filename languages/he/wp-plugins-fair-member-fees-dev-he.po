msgstr "הסבר על ההנחה"

#: build/blocks/fee-explanation/index.js:3 src/blocks/fee-explanation/index.js:53
msgid "Hours of the honorary members"
msgstr "שעות חברי הכבוד"

#: build/blocks/fee-explanation/index.js:3 src/blocks/fee-explanation/index.js:41
msgid "One number per member, separated by commas or spaces."
msgstr "מספר אחד לכל חבר, מופרדים בפסיקים או ברווחים."

#: build/blocks/fee-explanation/index.js:3 src/blocks/fee-explanation/index.js:37
msgid "Hours of the regular members"
msgstr "שעות החברים הרגילים"

#. translators: %s: currency code.
#: build/blocks/fee-explanation/index.js:3 build/blocks/membership-fees/index.js:3 src/blocks/fee-explanation/index.js:28 src/blocks/membership-fees/index.js:56
msgid "Base fee (%s)"
msgstr "דמי חבר בסיסיים (%s)"

#: build/blocks/fee-explanation/index.js:2 src/blocks/fee-explanation/index.js:22
msgid "Example"
msgstr "דוגמה"

#: build/blocks/fee-explanation/index.js:2 build/blocks/membership-fees/index.js:2 src/blocks/shared.js:300
msgid "Discount (%)"
msgstr "הנחה (%)"

#: build/blocks/fee-explanation/index.js:2 build/blocks/membership-fees/index.js:2 src/blocks/shared.js:282
msgid "The discount is calculated so that the regular members pay this amount together. If their calculated fees do not exceed it, there is no discount."
msgstr "ההנחה מחושבת כך שהחברים הרגילים ישלמו יחד סכום זה. אם דמי החבר המחושבים שלהם אינם עולים עליו, אין הנחה."

#. translators: %s: currency code.
#: build/blocks/fee-explanation/index.js:2 build/blocks/membership-fees/index.js:2 src/blocks/shared.js:279
